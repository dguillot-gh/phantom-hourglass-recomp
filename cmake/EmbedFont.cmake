# Embeds a binary font file into a C++ source as ph::kHdFontData and ph::kHdFontSize.
#   cmake -D INPUT=<font.ttf> -D OUTPUT=<file.cpp> -P EmbedFont.cmake
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR bytes "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" hex "${hex}")
set(out "// Generated by cmake/EmbedFont.cmake. Do not edit.\n#include <cstddef>\n\nnamespace ph {\nextern const unsigned char kHdFontData[] = {\n${hex}};\nextern const size_t kHdFontSize = ${bytes};\n}  // namespace ph\n")
file(WRITE "${OUTPUT}" "${out}")
