# The int-to-float fixes for GLSL ES, per shader (gles_shaders.cmake includes this for each shader `sh`, its text in
# `text`). Desktop GLSL converts an int operand to float by itself; GLSL ES needs a float literal or float(...).
# tools/check_gles_shaders.py checks the result with the NDK's glslc.

# Full-screen quads: positions in 0..1 to clip space.
if(sh MATCHES "^(2DCompositorVS|2DLayerPreVS|CaptureDownscaleVS)$")
  gles_fix("(vPosition * 2) - 1" "(vPosition * 2.0) - 1.0")
endif()

if(sh STREQUAL "2DCompositorVS")
  gles_fix("fTexcoord.zw = wide * uScaleFactor;" "fTexcoord.zw = wide * float(uScaleFactor);")
elseif(sh STREQUAL "2DCompositorFS")
  gles_fix("bgpos = vec2(bgoffset.xy) / 256;" "bgpos = vec2(bgoffset.xy) / 256.0;")
  gles_fix("BGRotscale[0]) / 256;" "BGRotscale[0]) / 256.0;")
  gles_fix("BGRotscale[1]) / 256;" "BGRotscale[1]) / 256.0;")
  gles_fix("bgpos.y += uBGConfig[2].MapOffset;" "bgpos.y += float(uBGConfig[2].MapOffset);")
  gles_fix("bgpos.y += uBGConfig[3].MapOffset;" "bgpos.y += float(uBGConfig[3].MapOffset);")
  gles_fix("(layercol[bg].a > 0)" "(layercol[bg].a > 0.0)")
  gles_fix("(layercol[4].a > 0)" "(layercol[4].a > 0.0)")
elseif(sh MATCHES "^(2DLayerPreFS|2DSpritePreFS)$")
  gles_fix("ret.a = ((col & 0xF) == 0) ? 0 : 1;" "ret.a = ((col & 0xF) == 0) ? 0.0 : 1.0;")
  gles_fix("ret.a = (col == 0) ? 0 : 1;" "ret.a = (col == 0) ? 0.0 : 1.0;")
  gles_fix("& 0x3E) / 63;" "& 0x3E) / 63.0;")
elseif(sh STREQUAL "2DSpritePreVS")
  gles_fix("vPosition * vec2(sprsize)" "vec2(vPosition) * vec2(sprsize)")
  gles_fix("((vtxpos * 2) / fbsize) - 1" "((vtxpos * 2.0) / fbsize) - 1.0")
elseif(sh STREQUAL "2DSpriteVS")
  gles_fix("* 2) / fbsize) - 1, z, 1)" "* 2.0) / fbsize) - 1.0, z, 1)")
  gles_fix("fPosition = vPosition;" "fPosition = vec2(vPosition);")
  gles_fix("(sprsize / 2)" "(sprsize / 2.0)")
elseif(sh STREQUAL "2DSpriteFS")
  gles_fix("float ymin = 0;" "float ymin = 0.0;")
  gles_fix("float mosy = coord.y - (line - mosline);" "float mosy = coord.y - float(line - mosline);")
  gles_fix("vec4(uRotscale[uOAM[fSpriteIndex].Rotscale]) / 256;" "vec4(uRotscale[uOAM[fSpriteIndex].Rotscale]) / 256.0;")
  gles_fix("(sprsize / 2)" "(sprsize / 2.0)")
  gles_fix("flags.g = 1;" "flags.g = 1.0;")
  gles_fix("flags.b = 1;" "flags.b = 1.0;")
  gles_fix("float(uOAM[fSpriteIndex].BGPrio) / 255;" "float(uOAM[fSpriteIndex].BGPrio) / 255.0;")
  gles_fix("coord += (ivec2(uOAM[fSpriteIndex].TileOffset) >> ivec2(1, "
           "coord += vec2(ivec2(uOAM[fSpriteIndex].TileOffset) >> ivec2(1, ")
  gles_fix("if (col.a == 0) discard;" "if (col.a == 0.0) discard;")
  gles_fix("flags.r = 1.0 / 255;" "flags.r = 1.0 / 255.0;")
  gles_fix("flags.r = 2.0 / 255;" "flags.r = 2.0 / 255.0;")
  gles_fix("float(uOAM[fSpriteIndex].PalOffset) / 31;" "float(uOAM[fSpriteIndex].PalOffset) / 31.0;")
elseif(sh MATCHES "^(3DClearFS|3DClearBitmapFS)$")
  gles_fix("oAttr.g = 0;" "oAttr.g = 0.0;")
  gles_fix("oAttr.a = 1;" "oAttr.a = 1.0;")
elseif(sh STREQUAL "3DFinalPassEdgeFS")
  gles_fix("if (attr.g != 0)" "if (attr.g != 0.0)")
  gles_fix("ret.a = 1;" "ret.a = 1.0;")
elseif(sh STREQUAL "3DFinalPassFogFS")
  gles_fix("if (attr.b != 0)" "if (attr.b != 0.0)")
elseif(sh STREQUAL "3DRenderVS")
  # vPolygonAttr comes as GL_UNSIGNED_INT (glVertexAttribIPointer), its texture layer word 0xFFFFnnnn. Desktop GL takes
  # it into an ivec3 bit for bit; on ES an int input fed unsigned data is undefined, and Mali clamps it to 0x7FFFFFFF:
  # every polygon then reads as untextured (layer 0xFFFF) and the 3D comes out white. Read it as a uvec3 and convert
  # (int(uint) keeps the bits).
  gles_fix("vPolygonAttr." "pattr.")
  gles_fix("in ivec3 vPolygonAttr;" "in uvec3 vPolygonAttr;")
  gles_fix("void main()\n{\n" "void main()\n{\n    ivec3 pattr = ivec3(vPolygonAttr);\n")
  gles_fix("1.0 / (16 * vec2(texwidth, texheight))" "1.0 / (16.0 * vec2(texwidth, texheight))")
  gles_fix("texcoord.y += capyoffset;" "texcoord.y += float(capyoffset);")
  gles_fix("fpos.z = 0;" "fpos.z = 0.0;")
elseif(sh STREQUAL "3DRenderFS")
  gles_fix("int(vcol.r * 31)" "int(vcol.r * 31.0)")
  gles_fix("col.a < 30.5/31)" "col.a < 30.5/31.0)")
  gles_fix("col.a < 0.5/31)" "col.a < 0.5/31.0)")
  gles_fix("col.a >= 30.5/31)" "col.a >= 30.5/31.0)")
  gles_fix("oAttr.g = 0;" "oAttr.g = 0.0;")
  gles_fix("oAttr.b = 0;" "oAttr.b = 0.0;")
  gles_fix("oAttr.a = 1;" "oAttr.a = 1.0;")
elseif(sh STREQUAL "CaptureVS")
  gles_fix("(pos * 2) - 1" "(pos * 2.0) - 1.0")
  gles_fix("fTexcoord.z = vTexcoord.y;" "fTexcoord.z = float(vTexcoord.y);")
elseif(sh STREQUAL "CaptureDownscaleFS")
  gles_fix("oColor.a = (col.a>0) ? 1 : 0;" "oColor.a = (col.a>0) ? 1.0 : 0.0;")
elseif(sh STREQUAL "CaptureFS")
  gles_fix("(coordA.x * 256.0 + uExtra) / (256.0 + 2.0 * uExtra)"
           "(coordA.x * 256.0 + float(uExtra)) / (256.0 + 2.0 * float(uExtra))")
elseif(sh STREQUAL "FinalPassVS")
  gles_fix("(vPosition.xyy + 1)" "(vPosition.xyy + 1.0)")
elseif(sh STREQUAL "FinalPassFS")
  gles_fix("(fTexcoord.x * (256.0 + 2.0 * uExtra) - uExtra) / 256.0"
           "(fTexcoord.x * (256.0 + 2.0 * float(uExtra)) - float(uExtra)) / 256.0")
  gles_fix("texture(MainInputTexA, fTexcoord.xy, 0)" "texture(MainInputTexA, fTexcoord.xy, 0.0)")
  gles_fix("vec2(xs, fTexcoord.y), 0)" "vec2(xs, fTexcoord.y), 0.0)")
  gles_fix("int(fTexcoord.y * 192)" "int(fTexcoord.y * 192.0)")
endif()

# Constant unsigned shifts as numbers (2DCompositorFS: `1u << 4`, `1u << 5`): the 2018 Adreno 5xx driver (LG V30) rejects
# the shader otherwise. For every shader, so a new one is covered too.
include(${CMAKE_CURRENT_LIST_DIR}/gles_fold_shifts.cmake)
gles_fold_const_shifts(text)
