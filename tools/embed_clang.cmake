# Packs the PC's clang + lld (a folder: clang.exe, ld.lld.exe, their DLLs, libmsvcrt.a) into one blob the exe carries
# (.incbin in clang_pack.S), for the optimised game build (frontend/src/pc_optimizer.cpp). Run with cmake -P:
#   -DDIR=<clang folder> -DOUT=<dir>   -> <dir>/clang_pack.bin, clang_pack_index.cpp, clang_pack.S
file(GLOB files RELATIVE "${DIR}" "${DIR}/*")
list(SORT files)
file(WRITE "${OUT}/clang_pack.bin" "")
set(entries "")
set(offset 0)
foreach(f IN LISTS files)
  if(IS_DIRECTORY "${DIR}/${f}")
    continue()
  endif()
  file(SIZE "${DIR}/${f}" size)
  # (cmake has no binary append: concatenate with cmake -E cat into a temp, then swap)
  execute_process(COMMAND ${CMAKE_COMMAND} -E cat "${OUT}/clang_pack.bin" "${DIR}/${f}"
                  OUTPUT_FILE "${OUT}/clang_pack.tmp" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "packing ${f} failed")
  endif()
  file(RENAME "${OUT}/clang_pack.tmp" "${OUT}/clang_pack.bin")
  string(APPEND entries "    {\"${f}\", ${offset}ull, ${size}ull},\n")
  math(EXPR offset "${offset} + ${size}")
endforeach()
file(WRITE "${OUT}/clang_pack_index.cpp.tmp"
  "// Generated by tools/embed_clang.cmake. Do not edit.\n#include \"pc_optimizer.hpp\"\n"
  "namespace ph {\nconst ClangPackEntry kClangPack[] = {\n${entries}};\n"
  "const int kClangPackCount = int(sizeof kClangPack / sizeof kClangPack[0]);\n}  // namespace ph\n")
file(COPY_FILE "${OUT}/clang_pack_index.cpp.tmp" "${OUT}/clang_pack_index.cpp" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}/clang_pack_index.cpp.tmp")
file(WRITE "${OUT}/clang_pack.S.tmp"
  "    .section .rdata,\"dr\"\n    .p2align 4\n    .globl ph_clang_pack\nph_clang_pack:\n"
  "    .incbin \"${OUT}/clang_pack.bin\"\n    .globl ph_clang_pack_end\nph_clang_pack_end:\n")
file(COPY_FILE "${OUT}/clang_pack.S.tmp" "${OUT}/clang_pack.S" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}/clang_pack.S.tmp")
