# Packs the files the first-run game build needs (TinyCC headers + libs, runtime headers, game config) into a C++
# source, so PhantomHourglass.exe carries them and nothing has to sit beside it. Run with cmake -P:
#   -DOUT=<file.cpp> -DTCC=<tinycc dir> -DONDEVICE=<tools/ondevice> -DRT=<runtime/include> -DCFG=<frontend/config: one folder per release>
set(entries "")
set(count 0)
function(add_file src dst)
  file(READ "${src}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  file(SIZE "${src}" size)
  file(APPEND "${OUT}.tmp" "static const unsigned char f${count}[] = {${hex}0};\n")
  set(entries "${entries}    {\"${dst}\", f${count}, ${size}},\n" PARENT_SCOPE)
  math(EXPR n "${count} + 1")
  set(count ${n} PARENT_SCOPE)
endfunction()
function(add_dir dir prefix)
  file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
  foreach(f IN LISTS files)
    add_file("${dir}/${f}" "${prefix}/${f}")
    set(entries "${entries}" PARENT_SCOPE)
    set(count ${count} PARENT_SCOPE)
  endforeach()
  set(entries "${entries}" PARENT_SCOPE)
  set(count ${count} PARENT_SCOPE)
endfunction()

file(WRITE "${OUT}.tmp" "// Generated by tools/embed_toolchain.cmake. Do not edit.\n#include \"embedded_toolchain.hpp\"\nnamespace {\n")
add_dir("${TCC}/include" "tcc/include")
add_file("${ONDEVICE}/stdint.h" "tcc/include/stdint.h")
add_file("${ONDEVICE}/string.h" "tcc/include/string.h")
add_dir("${TCC}/win32/lib" "tcc/lib")
add_file("${ONDEVICE}/dllstart.c" "tcc/lib/dllstart.c")
add_dir("${RT}" "rt")
add_dir("${CFG}" "config")
file(APPEND "${OUT}.tmp" "}  // namespace\nnamespace ph {\nconst EmbeddedFile kToolchainFiles[] = {\n${entries}};\nconst int kToolchainFileCount = ${count};\n}  // namespace ph\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
